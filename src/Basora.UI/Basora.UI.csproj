<Project Sdk="Microsoft.NET.Sdk">

  <!-- Layer rule 2: never reference Basora.PostgreSQL. View models talk to I* contracts
       from Basora.Core. If a view model needs Npgsql, the contract is wrong. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Basora.Core\Basora.Core.csproj" />
    <ProjectReference Include="..\Basora.Infrastructure\Basora.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
