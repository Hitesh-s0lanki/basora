<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Basora.UI;assembly=Basora.UI"
             x:Class="Basora.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system theme variant. "Dark" or "Light" are the other
         options. The real token dictionaries land at T-U01. -->

    <Application.DataTemplates>
        <ui:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
